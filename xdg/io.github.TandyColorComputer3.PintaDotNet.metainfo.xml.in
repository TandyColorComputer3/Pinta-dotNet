<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>io.github.TandyColorComputer3.PintaDotNet</id>
  <replaces>
    <id>pinta.desktop</id>
    <id>com.github.PintaProject.Pinta</id>
  </replaces>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Pinta.NET</name>
  <summary>Edit images — community fork with a reimagined UI</summary>
  <description>
    <_p>
      Pinta.NET is an independent fork of the Pinta image editor. It is not the official
      Pinta application from the Pinta project. This fork explores a reimagined user interface
      and may differ in behavior or packaging. Please report bugs and request support only on
      the Pinta.NET project page, not on upstream Pinta trackers.
    </_p>
    <_p>
      Image editing features are inherited from the Pinta codebase: drawing tools, layers,
      adjustments, and effects suitable for casual editing workflows.
    </_p>
  </description>
  <launchable type="desktop-id">io.github.TandyColorComputer3.PintaDotNet.desktop</launchable>
  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>HighContrast</kudo>
  </kudos>
  <developer_name>Pinta.NET contributors</developer_name>
  <url type="homepage">https://github.com/TandyColorComputer3/Pinta-dotNet</url>
  <url type="bugtracker">https://github.com/TandyColorComputer3/Pinta-dotNet/issues</url>
  <url type="faq">https://github.com/TandyColorComputer3/Pinta-dotNet/discussions</url>
  <url type="help">https://github.com/TandyColorComputer3/Pinta-dotNet/blob/main/readme.md</url>
  <url type="vcs-browser">https://github.com/TandyColorComputer3/Pinta-dotNet</url>
  <url type="translate">https://hosted.weblate.org/engage/pinta/</url>
  <content_rating type="oars-1.0" />
  <translation type="gettext">pinta</translation>
  <provides>
    <binary>pinta</binary>
  </provides>
  <releases>
    <release version="3.2" date="2026-05-05">
      <description>
        <p>Pinta.NET fork branding; use this app ID and repository for support.</p>
      </description>
    </release>
  </releases>
</component>
