[Desktop Entry]
Version=1.0
_Name=Pinta.NET
_Comment=Easily create and edit images — independent fork, not upstream Pinta
_GenericName=Image Editor
_X-GNOME-FullName=Pinta.NET Image Editor
TryExec=pinta
Exec=pinta %F
Icon=io.github.TandyColorComputer3.PintaDotNet
StartupNotify=false
StartupWMClass=PintaDotNet
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;RasterGraphics;GTK;
_Keywords=pinta.net;fork;draw;drawing;paint;painting;graphics;raster;2d;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/svg+xml;image/tiff;image/x-bmp;image/x-gray;image/x-icb;image/x-ico;image/x-png;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xbitmap;image/x-xpixmap;image/x-pcx;image/x-targa;image/x-tga;image/openraster;
